  "workspaces": [
    "compartilhado",
    "painel"
  ],
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "cheerio": "^1.2.0",
    "lighthouse": "^13.5.0",
    "opentype.js": "^2.0.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0"
  }
