{
  "name": "081-central-motos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "banco:migrar": "node --env-file=.env.supabase.local scripts/aplicar-migracao.mjs",
    "banco:semear": "node --env-file=.env.supabase.local scripts/rodar-sql.mjs supabase/seed/marcas-modelos.sql && node --env-file=.env.supabase.local scripts/rodar-sql.mjs supabase/seed/lojas.sql",
    "banco:tipos": "node --env-file=.env.supabase.local scripts/gerar-tipos.mjs",
    "banco:testar": "node --env-file=.env.supabase.local supabase/testes/regras.mjs && node --env-file=.env.local --env-file=.env.supabase.local supabase/testes/rls.mjs"
